rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function profilePath() {
      return /databases/(default)/documents/users/$(request.auth.uid);
    }
    function active() {
      return signedIn() &&
        firestore.exists(profilePath()) &&
        firestore.get(profilePath()).data.disabled != true &&
        request.auth.token.sessionVersion == firestore.get(profilePath()).data.get('sessionVersion', 0);
    }
    function admin() {
      return active() &&
        firestore.get(profilePath()).data.role == 'admin' &&
        firestore.get(profilePath()).data.approved == true;
    }
    function hr() {
      return active() && firestore.get(profilePath()).data.role == 'hr';
    }
    function coo() {
      return active() && firestore.get(profilePath()).data.role == 'coo';
    }
    function sameDepartmentReceipt(receiptId) {
      return active() &&
        firestore.exists(/databases/(default)/documents/receipts/$(receiptId)) &&
        firestore.get(/databases/(default)/documents/receipts/$(receiptId)).data.dept ==
          firestore.get(profilePath()).data.dept;
    }

    match /settings/logo.jpg {
      allow read: if active();
      allow create, update: if admin() &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if admin();
    }

    function isReceiptImage(receiptObject) {
      return receiptObject.matches('^[A-Za-z0-9_-]+\\.jpg

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
});
    }

    match /receipts/{receiptObject} {
      allow read: if isReceiptImage(receiptObject) &&
        (admin() || hr() || coo() ||
         sameDepartmentReceipt(receiptObject.split('\\.jpg')[0]));
      allow create, update: if isReceiptImage(receiptObject) &&
        (admin() || hr() ||
         sameDepartmentReceipt(receiptObject.split('\\.jpg')[0])) &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}